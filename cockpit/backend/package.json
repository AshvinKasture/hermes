{
  "name": "cockpit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit VM management app: backend API",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "coverage": "node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.d.ts' --test-coverage-exclude='src/index.ts' --test-coverage-include-all --test-coverage-lines=85 --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
