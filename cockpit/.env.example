# Copy to .env (gitignored) and fill in. Never commit real values.

# Google OAuth client. Redirect URI to register:
#   https://hermes.ashtech.dev/cockpit/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, 32+ chars (e.g. `openssl rand -hex 32`). Do not reuse across apps.
SESSION_SECRET=

# The only Google account allowed in. The server refuses to start if empty.
ALLOWED_EMAIL=ashvin.kasture12345@gmail.com

# Host user's UID/GID (run `id ashvin`)
APP_UID=1001
APP_GID=1001

# Terminal feature (all optional; shown defaults match what the server uses if unset).
# The container reaches the host's own sshd via the Docker bridge gateway, mapped to
# host.docker.internal in docker-compose.yml's extra_hosts.
# TERMINAL_SSH_HOST=host.docker.internal
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_USER=ashvin
# TERMINAL_IDLE_TIMEOUT_MS=900000
